// XTLS/REALITY reference: https://github.com/XTLS/REALITY
// Xray installation: https://github.com/XTLS/Xray-install
{
  "log": {
    "loglevel": "info",
    "error": "/var/log/xray/error.log",
    "access": "/var/log/xray/access.log"
  },
  "dns": {
    "servers": [
      {
        "address": "localhost",
        "domains": [
          "geosite:private",
          "domain:local",
          "domain:lan",
          "domain:home.arpa",
          "domain:connectivitycheck.gstatic.com",
          "domain:captive.apple.com",
          "domain:detectportal.firefox.com",
          "domain:msftconnecttest.com",
          "domain:msftncsi.com",
          "domain:kimi.ai",
          "domain:moonshot.ai",
          "domain:minimax.io",
          "domain:qoder.com",
          "domain:lovart.ai"
        ],
        "skipFallback": true
      },
      {
        "address": "https://1.1.1.1/dns-query",
        "domains": [
          "geosite:geolocation-!cn",
          "geosite:google",
          "geosite:category-ai-!cn",
          "geosite:github"
        ]
      },
      {
        // Domestic resolver. No expectedIPs filter: when a CN domain has a
        // legitimate overseas edge, filtering the answer sends the name to
        // the DoH fallback and then connects direct to a foreign IP.
        "address": "223.5.5.5",
        "domains": [
          "geosite:cn"
        ]
      },
      "https://1.1.1.1/dns-query"
    ],
    "queryStrategy": "UseIPv4",
    // First matching server wins, and a matching server never falls through.
    "disableFallbackIfMatch": true,
    // Answer from cache while the upstream is unreachable.
    "serveStale": true,
    "serveExpiredTTL": 3600
  },
  // Per-outbound byte counters: read with `xray api statsquery`.
  "stats": {},
  "policy": {
    "system": {
      "statsInboundUplink": true,
      "statsInboundDownlink": true,
      "statsOutboundUplink": true,
      "statsOutboundDownlink": true
    }
  },
  // Local gRPC surface for statsquery. Loopback only.
  "api": {
    "tag": "api",
    "services": ["StatsService", "HandlerService", "RoutingService"]
  },
  "inbounds": [
    {
      // TProxy redirects to loopback; 0.0.0.0 would expose the port to the LAN.
      "tag": "all-in",
      "listen": "127.0.0.1",
      "port": 12345,
      "protocol": "dokodemo-door",
      "settings": {
        "network": "tcp,udp",
        "followRedirect": true
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"],
        "routeOnly": true
      },
      "streamSettings": {
        "sockopt": {
          "tproxy": "tproxy"
        }
      }
    },
    {
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "port": 1080,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"],
        "routeOnly": true
      }
    },
    {
      // Admin surface: HandlerService can change routing at runtime.
      "tag": "api",
      "listen": "127.0.0.1",
      "port": 10085,
      "protocol": "dokodemo-door",
      "settings": {
        "address": "127.0.0.1"
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "vless",
      "tag": "proxy",
      "settings": {
        "vnext": [
          {
            "address": "<SERVER_IP:203.0.113.10>",
            "port": 10443,
            "users": [
              {
                "id": "<UUID:a1b2c3d4-e5f6-7890-abcd-ef1234567890>",
                "encryption": "none",
                "flow": "xtls-rprx-vision"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "fingerprint": "chrome",
          "serverName": "<SERVER_NAME:example.com>",
          "publicKey": "<PUBLIC_KEY:REDACTED_PUBLIC_KEY>",
          "shortId": "<SHORT_ID:0123456789abcdef>",
          "spiderX": "/"
        },
        "sockopt": {
          // TFO needs net.ipv4.tcp_fastopen to include the client bit (1 or 3).
          "tcpFastOpen": true,
          "happyEyeballs": {},
          "mark": 2,
          "tcpKeepAliveIdle": 15,
          "tcpKeepAliveInterval": 5
        }
      }
    },
    {
      "protocol": "freedom",
      "tag": "direct",
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "UseIPv4v6",
          "tcpFastOpen": true,
          "happyEyeballs": {},
          "mark": 2,
          "tcpKeepAliveIdle": 15,
          "tcpKeepAliveInterval": 5
        }
      }
    },
    {
      "protocol": "dns",
      "tag": "dns-out"
    },
    {
      "protocol": "blackhole",
      "tag": "blocked"
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        // Must stay first: a proxied API request breaks statsquery.
        "type": "field",
        "inboundTag": ["api"],
        "outboundTag": "api"
      },
      {
        "type": "field",
        "inboundTag": [
          "all-in",
          "socks-in"
        ],
        "port": 53,
        "outboundTag": "dns-out"
      },
      {
        // Every server address this profile talks to. Keep all of them
        // here: a proxied connection to the proxy itself would loop.
        "type": "field",
        "ip": [
          "<SERVER_IP:203.0.113.10>",
          "<SERVER_IP_2:198.51.100.20>"
        ],
        "outboundTag": "direct"
      },
      {
        // Hosts you reach directly by name, e.g. your own panel or site.
        "type": "field",
        "domain": ["domain:<OWN_DOMAIN:example.com>"],
        "outboundTag": "direct"
      },
      {
        // Connectivity checks must see the local link, not the tunnel. This
        // sits before every proxy rule: geosite:google and geolocation-!cn
        // both contain these names, so later placement silently shadows it.
        "type": "field",
        "domain": [
          "domain:connectivitycheck.gstatic.com",
          "domain:captive.apple.com",
          "domain:detectportal.firefox.com",
          "domain:msftconnecttest.com",
          "domain:msftncsi.com"
        ],
        "outboundTag": "direct"
      },
      {
        // Domestic AI providers that the !cn AI category also lists. Without
        // this rule they would leave through the tunnel and come back.
        "type": "field",
        "domain": [
          "domain:kimi.ai",
          "domain:moonshot.ai",
          "domain:minimax.io",
          "domain:qoder.com",
          "domain:lovart.ai"
        ],
        "outboundTag": "direct"
      },
      {
        // Source-hosting that must work with git/ssh over the proxy.
        "type": "field",
        "domain": [
          "geosite:github"
        ],
        "outboundTag": "proxy"
      },
      {
        // Ad and tracker domains are dropped, not proxied.
        "type": "field",
        "domain": [
          "geosite:category-ads-all"
        ],
        "outboundTag": "blocked"
      },
      {
        // Dropped, not "direct": sending torrents direct exposes the real IP
        // without bypassing anything. Use "proxy" instead if you accept the
        // server's terms of service and want the traffic tunnelled.
        "type": "field",
        "protocol": [ "bittorrent" ],
        "outboundTag": "blocked"
      },
      {
        "type": "field",
        "ip": ["geoip:private"],
        "outboundTag": "direct"
      },
      {
        // QUIC is dropped for everything not already direct above, and this
        // must precede every proxy rule. Routing is per packet but only the
        // first QUIC packet carries an SNI, so a domain rule in front of this
        // one tunnels the first packet and drops the rest of the same
        // connection: the browser then stalls on QUIC before falling back to
        // HTTP/2. Dropping it uniformly keeps that fallback immediate.
        // The tunnel is TCP (Vision), where QUIC would be UDP-in-TCP anyway.
        "type": "field",
        "network": "udp",
        "port": 443,
        "outboundTag": "blocked"
      },
      {
        // Mirrors that are faster and unthrottled through the tunnel.
        "type": "field",
        "domain": [
          "full:ftp.gnu.org",
          "domain:gnu.org",
          "domain:kernel.org"
        ],
        "outboundTag": "proxy"
      },
      {
        "type": "field",
        // The category covers 193 names (copilot, gemini, openrouter,
        // cerebras, ...); openai + anthropic alone covered a fraction.
        "type": "field",
        "domain": [
          "geosite:google",
          "geosite:category-ai-!cn"
        ],
        "outboundTag": "proxy"
      },
      {
        "type": "field",
        "domain": [
          "geosite:private",
          "geosite:cn"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "ip": ["geoip:cn"],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "network": "tcp,udp",
        "outboundTag": "proxy"
      }
    ]
  }
}
// vim: set ft=jsonc:

