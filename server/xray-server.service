[Unit]
Description=Xray Proxy Server Service
Documentation=https://github.com/XTLS/Xray-core
After=network-online.target nss-lookup.target
Wants=network-online.target

[Service]
Type=simple
User=xray
Group=xray
WorkingDirectory=/etc/xray
Environment="XRAY_LOCATION_ASSET=/usr/share/xray:/usr/share/v2ray-rules-dat"

# Allow binding low ports (80, 443) as an unprivileged user
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
NoNewPrivileges=true

# Refuse to start if configuration test fails
ExecStartPre=+/usr/bin/xray run -test -config /etc/xray/config.json
ExecStart=/usr/bin/xray run -config /etc/xray/config.json

Restart=always
RestartSec=2

LogsDirectory=xray
StateDirectory=xray

# System sandboxing
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
LimitNOFILE=1048576
TimeoutStartSec=15
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
