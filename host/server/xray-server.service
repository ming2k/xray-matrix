[Unit]
Description=Xray Proxy Server Service
Documentation=https://github.com/XTLS/Xray-core
After=network-online.target nss-lookup.target
Wants=network-online.target

[Service]
Type=simple
User=xray
Group=xray
WorkingDirectory=/etc/xray
Environment="XRAY_LOCATION_ASSET=/usr/share/xray:/usr/share/v2ray-rules-dat"

# Allow binding low ports (80, 443) as an unprivileged user
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
NoNewPrivileges=true

# Refuse to start if configuration test fails.
#
# LogsDirectory= owns the directory, not the files inside it: a root-run xray
# (a manual `sudo xray run`, or this preflight while it carried `+`) creates
# /var/log/xray/{access,error}.log as root:root 0600, and the unprivileged
# main process then dies with `open /var/log/xray/error.log: permission denied`
# (status=23). Re-assert ownership before every start.
ExecStartPre=+/bin/bash -c 'install -d -m 0755 -o xray -g xray /var/log/xray; touch /var/log/xray/access.log /var/log/xray/error.log; chown xray:xray /var/log/xray/access.log /var/log/xray/error.log; chmod 0640 /var/log/xray/access.log /var/log/xray/error.log'

# Without `+`: the preflight must run with the same identity as the main
# process, otherwise it can read a config — or write a log — that the service
# user cannot, and a permission defect only resurfaces as status=23 later.
ExecStartPre=/usr/bin/xray run -test -config /etc/xray/config.json
ExecStart=/usr/bin/xray run -config /etc/xray/config.json

Restart=always
RestartSec=2

LogsDirectory=xray
StateDirectory=xray

# System sandboxing
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
LimitNOFILE=1048576
TimeoutStartSec=15
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
