[Unit]
Description=Xray Transparent Proxy
Documentation=https://github.com/XTLS/Xray-core
After=network-online.target nss-lookup.target nftables.service
Wants=network-online.target nftables.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=xray
WorkingDirectory=/etc/xray
Environment=XRAY_LOCATION_ASSET=/usr/share/v2ray-rules-dat
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=true

# 1. Network setup: configure table 110 routes, policy routing rules, and load nftables
ExecStartPre=+/bin/bash -c '\
    ip route replace local default dev lo table 110; \
    ip -6 route replace local default dev lo table 110; \
    while ip rule del fwmark 0x1 table 110 2>/dev/null; do :; done; \
    while ip -6 rule del fwmark 0x1 table 110 2>/dev/null; do :; done; \
    ip rule add fwmark 0x1 table 110 priority 32765; \
    ip -6 rule add fwmark 0x1 table 110 priority 32765; \
    nft -f /etc/nftables/xray-tproxy.nft; \
'

# 2. Re-assert log directory and file ownership
ExecStartPre=+/bin/bash -c '\
    install -d -m 0755 -o xray -g xray /var/log/xray; \
    touch /var/log/xray/access.log /var/log/xray/error.log; \
    chown xray:xray /var/log/xray/access.log /var/log/xray/error.log; \
    chmod 0640 /var/log/xray/access.log /var/log/xray/error.log; \
'

# 3. Configuration preflight check (runs as User=xray, no +)
ExecStartPre=/usr/bin/xray run -test -config /etc/xray/config.json

# Main daemon process
ExecStart=/usr/bin/xray run -config /etc/xray/config.json

# 4. Startup verification: poll until TProxy listener binds port 12345
ExecStartPost=+/bin/bash -c '\
    for ((i = 0; i < 200; i++)); do \
        ss -lnH "sport = :12345" 2>/dev/null | grep -q . && exit 0; \
        sleep 0.05; \
    done; \
    echo "xray-tproxy: no TProxy listener on 12345 after 10s" >&2; \
    exit 1; \
'

Restart=always
RestartSec=2

# 5. Network restoration: stop traffic interception immediately, then clean up routes and rules
ExecStop=+/bin/bash -c '\
    nft delete table ip xray_v4 2>/dev/null || true; \
    nft delete table ip6 xray_v6 2>/dev/null || true; \
'
ExecStopPost=+/bin/bash -c '\
    nft delete table ip xray_v4 2>/dev/null || true; \
    nft delete table ip6 xray_v6 2>/dev/null || true; \
    ip route flush table 110 2>/dev/null || true; \
    ip -6 route flush table 110 2>/dev/null || true; \
    while ip rule del fwmark 0x1 table 110 2>/dev/null; do :; done; \
    while ip -6 rule del fwmark 0x1 table 110 2>/dev/null; do :; done; \
'

LogsDirectory=xray
StateDirectory=xray

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
LimitNOFILE=1048576
TimeoutStartSec=30
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
