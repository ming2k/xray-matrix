// Complete Server Configuration for VLESS + TCP + XTLS-Vision + REALITY
// Deploy to: /etc/xray/config.json
{
  "log": {
    "loglevel": "warning",
    "error": "/var/log/xray/error.log",
    "access": "/var/log/xray/access.log"
  },
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "<UUID:a1b2c3d4-e5f6-7890-abcd-ef1234567890>",
            "flow": "xtls-rprx-vision"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "<DEST_DOMAIN:example.com:443>",
          "xver": 0,
          "serverNames": [
            "<SERVER_NAME:example.com>"
          ],
          "privateKey": "<PRIVATE_KEY:REDACTED_PRIVATE_KEY>",
          "shortIds": [
            "<SHORT_ID:0123456789abcdef>"
          ]
        },
        "sockopt": {
          "tcpFastOpen": true
          // Do NOT add acceptProxyProtocol here: a REALITY inbound cannot parse
          // the PROXY protocol header, and every handshake then fails with
          // "tls: first record does not look like a TLS handshake". When a front
          // proxy must send one, terminate it one hop earlier — see
          // docs/how-to/share-port-443-with-a-website.md.
        }      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"]
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct",
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "UseIPv4v6"
        }
      }
    },
    {
      "protocol": "blackhole",
      "tag": "blocked"
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "protocol": ["bittorrent"],
        "outboundTag": "blocked"
      }
    ]
  }
}
